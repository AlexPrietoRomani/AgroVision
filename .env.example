# ===================================================================================
# AgroVisión — variables de entorno (PLANTILLA)
# ===================================================================================
# Copia este archivo a `.env` para desarrollo local: cp .env.example .env
#
# REGLAS DE SEGURIDAD:
#   - `.env.example` (versionado) lleva SOLO placeholders vacíos. NUNCA secretos reales.
#   - `.env` (en .gitignore) lleva tus valores reales para local. No se versiona.
#   - En PRODUCCIÓN, define los secretos en el panel de cada plataforma
#     (Supabase, Render, ShinyApps.io, Hugging Face), no en archivos.
# ===================================================================================

# -----------------------------------------------------------------------------------
# 1) General
# -----------------------------------------------------------------------------------
APP_ENV=development                       # development | production
LOG_LEVEL=info                            # info | debug | warning | error

# -----------------------------------------------------------------------------------
# 2) UI (Astro) <-> Backend (FastAPI)
# -----------------------------------------------------------------------------------
SHINY_HOST=127.0.0.1
SHINY_PORT=8001
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000        # En prod: URL pública del backend en Render
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001,https://<tu-app>.hf.space
CONFIDENCE_THRESHOLD=0.25
MAX_UPLOAD_MB=50

# -----------------------------------------------------------------------------------
# 3) Despliegue -> Hugging Face Spaces (SDK Docker)  [VÍA ACTIVA — ver docs/ejecucion.md §5]
#    HF construye el Dockerfile de la raíz (gateway FastAPI: UI / + API /api).
#    Token (write) en: https://huggingface.co/settings/tokens
#    Crea el Space (una vez, web): https://huggingface.co/new-space -> SDK "Docker".
#    Deploy:  ./scripts/deploy_hf.sh (Linux/macOS) o ./scripts/deploy_hf.ps1 (Windows)
# -----------------------------------------------------------------------------------
HF_SPACE_ID=<tu_usuario>/agrovision     # <usuario>/<space>, p. ej. alexprieto/agrovision
# HF_TOKEN se define en la sección 5; sirve tanto para el Space como para el modelo.

# -----------------------------------------------------------------------------------
# 3b) Alternativas de despliegue (opcionales):
#   - Render (Docker, free): backend/Dockerfile + render.yaml. API en dashboard.render.com/u/settings
#   - Posit Connect (de pago): rsconnect deploy fastapi (scripts/deploy_prod.ps1).
#     OJO: shinyapps.io NO hospeda FastAPI (solo Shiny); estas vars solo aplican a Posit Connect.
# -----------------------------------------------------------------------------------
RENDER_API_KEY=
RENDER_SERVICE_ID=
SHINYAPPS_ACCOUNT=
SHINYAPPS_TOKEN=
SHINYAPPS_SECRET=

# -----------------------------------------------------------------------------------
# 5) Modelo de conteo + Hugging Face Hub
#    Token HF en: https://huggingface.co/settings/tokens (write si vas a publicar)
# -----------------------------------------------------------------------------------
COUNTING_ENABLED=false                    # true para activar el conteo (mock o real)
MODEL_BACKEND=mock                         # mock (datos falsos para probar) | onnx (modelo real)
MODEL_PATH=/app/models/agrovision-plantcount-v2.0.0.onnx
MODEL_VERSION=2.0.0
MODEL_ARCHITECTURE=yolo26n                # yolo26n | rfdetr_nano (define el adaptador de decode)
HF_MODEL_REPO=<org>/agrovision-plantcount

# -----------------------------------------------------------------------------------
# 5) Token de escritura HF (para deploy script; no se versiona en .env versionado)
# -----------------------------------------------------------------------------------
HF_TOKEN=hf_placeholder_write_token       # <token write> en: https://huggingface.co/settings/tokens

# -----------------------------------------------------------------------------------
# 6) Telemetría de UI (Fase 9)
#    Los eventos siempre se loguean en stdout y se guardan en un buffer en memoria
#    (GET /api/events/recent). EVENTS_PERSIST=true además los persiste en la tabla
#    `events` de Supabase (best-effort; requiere DATABASE_URL). Nunca contiene secretos.
# -----------------------------------------------------------------------------------
EVENTS_PERSIST=false                      # true para volcar la telemetría a la tabla events

# -----------------------------------------------------------------------------------
# 7) Seguridad / hardening
#    Rate limiting en memoria sobre /api (anti-abuso/DDoS). 0 = desactivado.
# -----------------------------------------------------------------------------------
RATE_LIMIT_PER_MIN=120                     # peticiones/min por IP a /api (0 desactiva)

# -----------------------------------------------------------------------------------
# 6) Supabase (BD PostGIS + Storage + Queues) — PLATAFORMA COMPLETA
#    Por defecto, DATABASE_URL usa el Session pooler (puerto 5432) — ideal para desarrollo
#    y el Transaction pooler (puerto 6543) — ideal para producción concurrente.
#    SERVICE_ROLE es SECRETO (solo backend, nunca UI).
# -----------------------------------------------------------------------------------
SUPABASE_URL=https://<proyecto>.supabase.co   # https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9. placeholder_anon_key  # eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9. ...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9. placeholder_service_role  # eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9. ...
SUPABASE_STORAGE_BUCKET=drone-images

# DATABASE_URL: cadena PostgreSQL con asyncpg. Obtener en Supabase:
#   1. Entra a tu proyecto en https://supabase.com/dashboard
#   2. En la barra superior, haz clic en el botón "Connect" (al lado del nombre del proyecto).
#   3. En la pestaña "Connection String", selecciona "URI" y Method: "Session pooler" (puerto 5432)
#      o "Transaction pooler" (puerto 6543).
#   4. Copia la URI, reemplaza [YOUR-PASSWORD] por la contraseña de tu BD y usa el prefijo
#      postgresql+asyncpg://
#   Ejemplo con Session pooler:
#     DATABASE_URL=postgresql+asyncpg://postgres.<proyecto>.supabase.co:5432/postgres?sslmode=require
#   Ejemplo con Transaction pooler:
#     DATABASE_URL=postgresql+asyncpg://postgres.abcdefghijklm:MiClaveSegura123@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.<proyecto>.supabase.co:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------------
# 7) Groq — modelo BYOK ("Trae tu propia llave")
#    En PRODUCCIÓN estas llaves NO se guardan en el servidor: el usuario las inyecta
#    por sesión (cabeceras X-User-*) y se descartan. Las DEV_* de abajo son SOLO para
#    pruebas locales sin el flujo BYOK.
#    - Groq (agente RAG / Llama 3): https://console.groq.com/keys
# -----------------------------------------------------------------------------------
#    1. Ve a https://console.groq.com/keys y haz click en "Create Key".
#    2. Genera un key tipo gsk_... para Llama 3.
# -----------------------------------------------------------------------------------
DEV_GROQ_API_KEY=gsk_placeholder_groq_key   # gsk_... en: https://console.groq.com/keys

# -----------------------------------------------------------------------------------
# 8) APIs satelitales — modelo BYOK ("Trae tu propia llave")
#    En PRODUCCIÓN estas llaves NO se guardan en el servidor: el usuario las inyecta
#    por sesión (cabeceras X-User-*) y se descartan. Las DEV_* de abajo son SOLO para
#    pruebas locales sin el flujo BYOK.
#    - Copernicus CDSE (Sentinel-2): https://dataspace.copernicus.eu/
#      1. Regístrate en https://dataspace.copernicus.eu/ -> MyAccess -> Client ID/Secret
#      2. Anota tu Client ID y Client Secret (nivel gratuito: 100 MB/día de Sentinel-2).
#      (el primer registro requiere aprobación; las credenciales son de capa gratuita).
#    - Open-Meteo: sin llave. NASA POWER: acceso público por coordenadas.
# -----------------------------------------------------------------------------------
DEV_COPERNICUS_CLIENT_ID=placeholder_copernicus_id   # ID OAuth en dataspace.copernicus.eu
DEV_COPERNICUS_CLIENT_SECRET=placeholder_copernicus_secret  # Secret OAuth en dataspace.copernicus.eu