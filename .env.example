# ===================================================================================
# AgroVisión — variables de entorno (PLANTILLA GUIADA PASO A PASO)
# ===================================================================================
# Copia este archivo a `.env` para desarrollo local: cp .env.example .env
#
# REGLAS DE SEGURIDAD:
#   - `.env.example` (versionado) lleva SOLO placeholders y dummies seguros. NUNCA secretos reales.
#   - `.env` (en .gitignore) lleva tus valores reales para local. No se versiona.
#   - En PRODUCCIÓN, define los secretos en el panel de cada plataforma
#     (Supabase, Render, ShinyApps.io, Hugging Face), no en archivos.
# ===================================================================================

# -----------------------------------------------------------------------------------
# 1) General
# -----------------------------------------------------------------------------------
APP_ENV=development                       # development | production
LOG_LEVEL=info                            # info | debug | warning | error

# -----------------------------------------------------------------------------------
# 2) UI (Astro) <-> Backend (FastAPI)
# -----------------------------------------------------------------------------------
SHINY_HOST=127.0.0.1
SHINY_PORT=8001
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000        # En prod: URL pública del backend en Render o HF
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001,https://<tu-app>.hf.space
CONFIDENCE_THRESHOLD=0.25
MAX_UPLOAD_MB=50

# -----------------------------------------------------------------------------------
# 3) Despliegue -> Hugging Face Spaces (SDK Docker)  [VÍA ACTIVA — ver docs/ejecucion.md §5]
#    HF construye el Dockerfile de la raíz (gateway FastAPI: UI / + API /api).
#    Guía paso a paso para configurar Hugging Face:
#      1. Ve a https://huggingface.co/new-space para crear un nuevo Space.
#      2. Selecciona tu Owner (ej. tu usuario), Space name (ej. "agrovision") y SDK "Docker" (Blank).
#      3. Define HF_SPACE_ID=<tu_usuario>/agrovision (ej. alexp97/agrovision).
#      4. Ve a https://huggingface.co/settings/tokens y haz clic en "Create new token" (o "New token").
#      5. Asigna el tipo "Write" (escritura) y copia el token generado.
#      6. Deploy: ./scripts/deploy_hf.sh (Linux/macOS) o ./scripts/deploy_hf.ps1 (Windows).
# -----------------------------------------------------------------------------------
HF_SPACE_ID=<tu_usuario>/agrovision     # <usuario>/<space>, p. ej. alexprieto/agrovision
HF_TOKEN=hf_placeholder_write_token       # <token write> en: https://huggingface.co/settings/tokens

# -----------------------------------------------------------------------------------
# 4) Alternativas de despliegue (opcionales):
#   - Render (Docker, free): backend/Dockerfile + render.yaml. API en dashboard.render.com/u/settings
#   - Posit Connect (de pago): rsconnect deploy fastapi (scripts/deploy_prod.ps1).
#     OJO: shinyapps.io NO hospeda FastAPI (solo Shiny); estas vars solo aplican a Posit Connect.
# -----------------------------------------------------------------------------------
RENDER_API_KEY=
RENDER_SERVICE_ID=
SHINYAPPS_ACCOUNT=
SHINYAPPS_TOKEN=
SHINYAPPS_SECRET=

# -----------------------------------------------------------------------------------
# 5) Modelo de conteo + Hugging Face Hub
# -----------------------------------------------------------------------------------
COUNTING_ENABLED=false                    # true para activar el conteo (mock o real)
MODEL_BACKEND=mock                         # mock (datos falsos para probar) | onnx (modelo real)
MODEL_PATH=/app/models/agrovision-plantcount-v2.0.0.onnx
MODEL_VERSION=2.0.0
MODEL_ARCHITECTURE=yolo26n                # yolo26n | rfdetr_nano (define el adaptador de decode)
HF_MODEL_REPO=<org>/agrovision-plantcount

# -----------------------------------------------------------------------------------
# 6) Telemetría de UI y hardening
#    Los eventos siempre se loguean en stdout y se guardan en un buffer en memoria
#    (GET /api/events/recent). EVENTS_PERSIST=true además los persiste en la tabla
#    `events` de Supabase (best-effort; requiere DATABASE_URL). Nunca contiene secretos.
#    RATE_LIMIT_PER_MIN: peticiones/min por IP a /api (anti-abuso/DDoS). 0 = desactivado.
# -----------------------------------------------------------------------------------
EVENTS_PERSIST=false                      # true para volcar la telemetría a la tabla events
RATE_LIMIT_PER_MIN=120                     # peticiones/min por IP a /api (0 desactiva)

# -----------------------------------------------------------------------------------
# 7) Supabase (BD PostGIS + Storage + Queues) — PLATAFORMA COMPLETA
# -----------------------------------------------------------------------------------
# GUÍA CLIC POR CLIC PARA QUIEN NUNCA HA USADO SUPABASE:
#
# PASO 0 — Crear tu proyecto en Supabase (si aún no tienes uno):
#   1. Entra a https://supabase.com/dashboard e inicia sesión (o crea cuenta gratis con GitHub / email).
#   2. En el panel principal, haz clic en el botón verde "New project" (Nuevo proyecto).
#   3. Selecciona tu Organización (o crea una gratuita si es tu primera vez).
#   4. Asigna un nombre a tu proyecto (ej. "agrovision-db").
#   5. En "Database Password", escribe una contraseña segura y ¡GUÁRDALA EN UN LUGAR SEGURO!
#      (La necesitarás más adelante para armar tu DATABASE_URL).
#   6. Elige la región geográfica más cercana (ej. "East US (North Virginia) - us-east-1").
#   7. Haz clic en "Create new project" y espera ~1 a 2 minutos hasta que termine de aprovisionarse.
#
# CÓMO OBTENER CADA VARIABLE EN SUPABASE:
#
# A) SUPABASE_URL:
#   Paso 1: En el panel de tu proyecto en https://supabase.com/dashboard, ve a la barra lateral
#           izquierda abajo del todo y haz clic en "Project Settings" (ícono de engranaje ⚙️).
#   Paso 2: En el menú lateral de configuración ("Configuration"), haz clic en "Data API"
#           (o en "API" en proyectos anteriores).
#   Paso 3: En el bloque "Project URL", haz clic en el botón "Copy" al lado de la URL.
#   Ejemplo de formato: https://xyzcompanyabcdefgh.supabase.co
# -----------------------------------------------------------------------------------
SUPABASE_URL=https://<proyecto>.supabase.co   # Ejemplo: https://xyzcompanyabcdefgh.supabase.co

# B) SUPABASE_ANON_KEY (clave pública para clientes / anon):
#   Paso 1: En la barra lateral izquierda de tu proyecto en Supabase, ve a "Project Settings (⚙️)".
#   Paso 2: En el menú "Configuration", haz clic en "API Keys"
#           (o en "Project Settings -> API -> Project API keys"; si aparece la vista nueva,
#           puedes copiar el formato nuevo sb_publishable_... o abrir la pestaña "Legacy API keys"
#           para el formato JWT eyJhbGci...; ambos formatos son válidos en AgroVisión).
#   Paso 3: Busca la fila con el nombre "anon" ("public") y haz clic en "Copy".
#   Ejemplo de formato nuevo: sb_publishable_placeholder_anon_key
#   Ejemplo de formato legacy: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.placeholder_anon_key
# -----------------------------------------------------------------------------------
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.placeholder_anon_key   # eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9. ... (o sb_publishable_...)

# C) SUPABASE_SERVICE_ROLE_KEY (clave SECRETA de administración backend):
#   Paso 1: En la misma pantalla "Project Settings (⚙️) -> API Keys".
#           (En la vista nueva puedes copiar el formato sb_secret_... o en "Legacy API keys"
#           el formato JWT eyJhbGci...; ambos formatos son válidos).
#   Paso 2: Busca la fila con el nombre "service_role" ("secret").
#   Paso 3: Haz clic en el botón "Reveal" (mostrar) para desbloquear la clave y luego en "Copy".
#   ATENCIÓN: Esta clave es secreta de backend (salta Row Level Security). NUNCA se expone en el
#             navegador, ni en el frontend, ni en repositorios de código público.
#   Ejemplo de formato nuevo: sb_secret_placeholder_service_role
#   Ejemplo de formato legacy: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.placeholder_service_role
# -----------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.placeholder_service_role   # eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9. ... (o sb_secret_...)

# D) SUPABASE_STORAGE_BUCKET (almacenamiento de ortomosaicos e imágenes de dron):
#   Paso 1: En la barra lateral izquierda de Supabase, haz clic en "Storage" (ícono de carpeta/caja).
#   Paso 2: Haz clic en el botón "New bucket" (o "Create bucket").
#   Paso 3: En el campo del nombre escribe "drone-images" (sin comillas).
#   Paso 4: Guarda los cambios. (Opcional, solo requerido para el módulo de conteo por dron).
# -----------------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET=drone-images   # drone-images (opcional, solo para módulo de dron)

# E) DATABASE_URL (cadena de conexión PostgreSQL asíncrona con asyncpg):
#   Paso 1: En el panel de tu proyecto en https://supabase.com/dashboard, ubica la barra superior.
#   Paso 2: Haz clic en el botón "Connect" (ubicado arriba al lado del nombre del proyecto).
#   Paso 3: En el diálogo emergente, selecciona la pestaña "Connection String" y luego la pestaña "URI".
#   Paso 4: En el selector "Method" o "Mode", elige una de las dos opciones:
#             - "Session pooler" (puerto 5432) -> ideal para desarrollo local y migraciones DDL directas.
#             - "Transaction pooler" (puerto 6543) -> ideal para entornos serverless y producción concurrente.
#   Paso 5: Haz clic en el botón de copiar para copiar la URI generada.
#   Paso 6: Reemplaza "[YOUR-PASSWORD]" por la contraseña de base de datos que creaste en el Paso 0.
#           (¿Olvidaste tu contraseña? Ve a:
#            Project Settings ⚙️ -> Database -> Database password -> Reset database password
#            para definir una nueva sin perder tus datos ni tus tablas).
#   Paso 7: Cambia el prefijo inicial "postgresql://" o "postgres://" por "postgresql+asyncpg://".
#   Ejemplo con Session pooler (puerto 5432):
#     DATABASE_URL=postgresql+asyncpg://postgres.<proyecto>:MiClaveSegura123@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#   Ejemplo con Transaction pooler (puerto 6543):
#     DATABASE_URL=postgresql+asyncpg://postgres.abcdefghijklm:MiClaveSegura123@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres.<proyecto>.supabase.co:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------------
# 8) Groq — Agente RAG / Asistente Inteligente (modelo BYOK)
# -----------------------------------------------------------------------------------
# En PRODUCCIÓN estas llaves NO se guardan en el servidor: el usuario las inyecta
# por sesión (cabeceras X-User-Groq-Api-Key) y se descartan. DEV_GROQ_API_KEY abajo es
# SOLO para pruebas locales directas sin el modal BYOK.
#
# Guía paso a paso para obtener tu API Key de Groq:
#   Paso 1: Ve a https://console.groq.com/ e inicia sesión (o regístrate gratis).
#   Paso 2: En la barra lateral izquierda, haz clic en "API Keys"
#           (o ingresa directo a https://console.groq.com/keys).
#   Paso 3: Haz clic en el botón "Create API Key" (o "Create Key").
#   Paso 4: Asigna un nombre a la llave (ej. "AgroVision-Dev") y haz clic en "Submit".
#   Paso 5: Copia la llave generada que empieza con "gsk_...".
#           (Guárdala de inmediato, no se volverá a mostrar en la interfaz).
#   Ejemplo de formato: gsk_abcdefghijklmnopqrstuvwxyz0123456789
# -----------------------------------------------------------------------------------
DEV_GROQ_API_KEY=gsk_placeholder_groq_key   # gsk_... en: https://console.groq.com/keys

# -----------------------------------------------------------------------------------
# 9) Copernicus CDSE (Sentinel-2 Satelital) — modelo BYOK
# -----------------------------------------------------------------------------------
# En PRODUCCIÓN estas llaves NO se guardan en el servidor: el usuario las inyecta
# por sesión (cabeceras X-User-Copernicus-*) y se descartan. DEV_COPERNICUS_* abajo son
# SOLO para pruebas locales directas sin el modal BYOK.
#
# Guía paso a paso para obtener tus credenciales Copernicus Data Space Ecosystem:
#   Paso 1: Regístrate gratis en https://dataspace.copernicus.eu/
#   Paso 2: Inicia sesión, haz clic en tu usuario (arriba a la derecha) y selecciona "My Access"
#           (o ve a https://dataspace.copernicus.eu/ -> User profile).
#   Paso 3: En la sección "OAuth Clients" (o "Keycloak / API Access"), haz clic en "Create OAuth Client"
#           (o "Add Client").
#   Paso 4: Escribe un nombre para el cliente (ej. "agrovision-sentinel") y confirma.
#   Paso 5: Copia el "Client ID" y el "Client Secret" generados.
#           (Capa gratuita incluye 100 MB/día de datos satelitales Sentinel-2 L2A).
#   - Open-Meteo: sin llave (acceso público automático por coordenadas).
#   - NASA POWER: acceso público automático por coordenadas.
# -----------------------------------------------------------------------------------
DEV_COPERNICUS_CLIENT_ID=placeholder_copernicus_id   # ID OAuth en dataspace.copernicus.eu
DEV_COPERNICUS_CLIENT_SECRET=placeholder_copernicus_secret  # Secret OAuth en dataspace.copernicus.eu
