---
import Layout from "../layouts/Layout.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import ControlPanel from "../components/layout/ControlPanel.astro";
import ResumenCampo from "../components/modules/ResumenCampo.astro";
import Teledeteccion from "../components/modules/Teledeteccion.astro";
import Meteorologia from "../components/modules/Meteorologia.astro";
import AnalisisCruzado from "../components/modules/AnalisisCruzado.astro";
import ConteoDron from "../components/modules/ConteoDron.astro";
import ExploradorDatos from "../components/modules/ExploradorDatos.astro";
import AjustesPerfil from "../components/modules/AjustesPerfil.astro";
import CredentialsModal from "../components/ui/CredentialsModal.astro";
import TelemetryModal from "../components/ui/TelemetryModal.astro";
import ReprocessModal from "../components/ui/ReprocessModal.astro";
---

<Layout title="AgroVisión — Plataforma Agronómica">
  <Sidebar />

  <!-- MAIN BODY CONTENEDOR (SECCIÓN 2 + SECCIÓN 3) -->
  <main id="main" class="flex-1 flex overflow-hidden h-full">
    <ControlPanel />

    <!-- SECCIÓN 3: PANEL DERECHO DINÁMICO (TAB CONTENTS) -->
    <div id="panel-right" class="flex-grow overflow-y-auto bg-stone-50 h-full p-5 md:p-8">
      <ResumenCampo />
      <Teledeteccion />
      <Meteorologia />
      <AnalisisCruzado />
      <ConteoDron />
      <ExploradorDatos />
      <AjustesPerfil />
      <CredentialsModal />
    </div>
  </main>

  <TelemetryModal />
  <ReprocessModal />
</Layout>
